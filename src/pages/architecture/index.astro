---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import { isListable, sortByDateDesc } from "../../lib/content";

const entries = sortByDateDesc((await getCollection("architecture")).filter(isListable));
---

<BaseLayout
  title="Architecture — collante.ai"
  description="Reference architectures for enterprise Data & AI systems — governed, scalable, and built to survive contact with production."
  width="standard"
>
  <div class="architecture-index">
    <p class="architecture-index__eyebrow">Architecture</p>
    <h1>Reference architectures</h1>
    <p class="architecture-index__intro">
      Curated architecture studies, not a project gallery — each one a generic, independently developed
      reference pattern, not client work.
    </p>

    <ol class="architecture-index__list">
      {
        entries.map((entry, i) => (
          <li class="architecture-index__item">
            <span class="architecture-index__number">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="architecture-index__type">{entry.data.architectureType} architecture</p>
              <h2><a href={`/architecture/${entry.id}/`}>{entry.data.title}</a></h2>
              <p class="architecture-index__description">{entry.data.description}</p>
              <TagList patternTags={entry.data.patternTags} stackTags={entry.data.stackTags} />
              <a class="architecture-index__link" href={`/architecture/${entry.id}/`}>
                Explore →
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .architecture-index {
    padding-block: var(--space-8) var(--space-9);
  }

  .architecture-index__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .architecture-index__intro {
    margin-top: var(--space-4);
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .architecture-index__list {
    margin-top: var(--space-8);
  }

  .architecture-index__item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-top: var(--border-width) solid var(--color-line);
  }

  .architecture-index__item:last-child {
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .architecture-index__number {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .architecture-index__type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .architecture-index__item h2 {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
  }

  .architecture-index__item h2 a:hover {
    color: var(--color-accent);
  }

  .architecture-index__description {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    max-width: var(--width-reading);
  }

  .architecture-index__item :global(.tag-list) {
    margin-top: var(--space-4);
  }

  .architecture-index__link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  @media (max-width: 35.9375rem) {
    .architecture-index__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
