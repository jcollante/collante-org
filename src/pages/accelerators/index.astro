---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { isListable, sortByDateDesc } from "../../lib/content";

const entries = sortByDateDesc((await getCollection("accelerators")).filter(isListable));
---

<BaseLayout
  title="Accelerators — collante.ai"
  description="Reusable architecture frameworks for moving enterprise Data & AI initiatives from proof-of-concept toward governed production."
  width="standard"
>
  <div class="listing">
    <p class="listing__eyebrow">Accelerators</p>
    <h1>Accelerators</h1>
    <p class="listing__intro">
      Reusable frameworks and maturity models — generic, independently developed, not employer-owned assets.
    </p>

    <ul class="listing__list">
      {
        entries.map((entry) => (
          <ArticleCard
            href={`/accelerators/${entry.id}/`}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            patternTags={entry.data.patternTags}
            stackTags={entry.data.stackTags}
          />
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .listing {
    padding-block: var(--space-8) var(--space-9);
  }

  .listing__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .listing__intro {
    margin-top: var(--space-4);
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .listing__list {
    margin-top: var(--space-8);
  }
</style>
