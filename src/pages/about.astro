---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../lib/site";
import { personJsonLd } from "../lib/personJsonLd";

const canonicalUrl = new URL("/about/", siteConfig.url).toString();
---

<BaseLayout
  title="About — collante.org"
  description={`${siteConfig.name}, ${siteConfig.role} — background, expertise, and professional links.`}
  width="reading"
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={`About — ${siteConfig.name}`} />
    <meta property="og:description" content={`${siteConfig.name}, ${siteConfig.role} — background, expertise, and professional links.`} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/og-default.png", siteConfig.url).toString()} />
    <meta property="og:site_name" content="collante.org" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd())} />
  </Fragment>

  <div class="about">
    <p class="about__eyebrow">About</p>
    <h1>{siteConfig.name}</h1>
    <p class="about__role">{siteConfig.role}</p>

    <div class="about__intro">
      <!-- TODO: replace with a real photo (no circular crop). -->
      <div class="about__portrait" role="img" aria-label="Portrait placeholder — replace with a real photo">
        <span>Portrait — TODO: replace with a real photo (no circular crop)</span>
      </div>
      <p class="about__positioning">
        Data &amp; AI Architect and technology consultant with 15+ years of experience across software
        engineering, business intelligence, data engineering, cloud platforms and enterprise data
        architecture. I design and deliver scalable Data &amp; AI solutions that bridge business
        requirements, architecture and engineering.
      </p>
    </div>

    <section class="about__section">
      <h2>Experience</h2>
      <p>
        For the past 8+ years I have worked at Deloitte as a Senior Consultant and Data &amp; AI Architect,
        designing and delivering enterprise data platforms. My background combines hands-on technical expertise with client-facing consulting, technical
        leadership, delivery, data governance and team development. I specialize in modern data platforms,
        Azure Databricks, Lakehouse architectures, data engineering, ETL/ELT, data modelling and enterprise
        integration.
      </p>
      <p>
        Throughout my consulting career, I have worked directly with clients to shape solutions, define
        architectures and implementation roadmaps, lead multidisciplinary teams, establish governance
        practices and support presales through PoCs and solution presentations.
      </p>
      <p>
        I am particularly interested in modern Data &amp; AI platforms that combine scalable data
        engineering, strong governance and AI-ready architectures to create measurable business value.
      </p>
      <p>
        Based in the Stuttgart/Ludwigsburg region and experienced working in international environments in
        German and English.
      </p>
    </section>

    <section class="about__section">
      <h2>Areas of expertise</h2>
      <ul class="about__list">
        <li>Data &amp; solution architecture</li>
        <li>Lakehouse and cloud data platforms</li>
        <li>Data engineering, ETL/ELT and data modelling</li>
        <li>Data governance and architecture governance</li>
        <li>Technical leadership and stakeholder management</li>
        <li>Presales and proofs of concept</li>
      </ul>
    </section>

    <section class="about__section">
      <h2>Selected technologies</h2>
      <p class="about__tech-line">
        Azure Databricks · Delta Lake · Unity Catalog · PySpark &amp; Spark SQL · Python · SQL · ADLS Gen2 ·
        Azure Data Factory · Azure DevOps · Git · Terraform
      </p>
    </section>

    <section class="about__section">
      <h2>Certifications</h2>
      <ul class="about__list">
        <li>Databricks Certified Data Engineer Professional (2026)</li>
        <li>Databricks Certified Data Engineer Associate (2026)</li>
        <li>Microsoft DP-200: Implementing an Azure Data Solution (2021)</li>
        <li>ICP-ACC Agile Coaching (2023)</li>
        <li>SAFe Agilist (2022)</li>
        <li>Certified ScrumMaster (CSM) (2022)</li>
      </ul>
      <h3 class="about__subheading">Databricks accreditations</h3>
      <ul class="about__list">
        <li>Azure Databricks Platform Architect (2026)</li>
        <li>Gen AI &amp; LLM on Databricks — Pre-Sales Verified (2026)</li>
      </ul>
      <p class="about__verify">
        <a href={siteConfig.databricksCredentialsUrl}>Verify on Databricks Credentials</a>
      </p>
    </section>

    <section class="about__section">
      <h2>Contact</h2>
      <ul class="about__links">
        <li><a href={siteConfig.linkedInUrl}>LinkedIn</a></li>
        <li><a href={`mailto:${siteConfig.email}`}>Email</a></li>
        {siteConfig.githubUrl && <li><a href={siteConfig.githubUrl}>GitHub</a></li>}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-8) var(--space-9);
  }

  .about__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .about__role {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .about__intro {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 13.75rem 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .about__positioning {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .about__portrait {
    aspect-ratio: 3 / 4;
    border: var(--border-width) dashed var(--color-line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 36rem) {
    .about__intro {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      max-width: 13.75rem;
    }
  }

  .about__section {
    margin-top: var(--space-8);
  }

  .about__section p + p {
    margin-top: var(--space-4);
  }

  .about__list {
    margin-top: var(--space-3);
    padding-left: var(--space-5);
    list-style: disc;
  }

  .about__list li + li {
    margin-top: var(--space-2);
  }

  .about__subheading {
    margin-top: var(--space-5);
    font-size: var(--text-base);
  }

  .about__verify {
    margin-top: var(--space-4);
  }

  .about__verify a {
    color: var(--color-accent);
  }

  .about__tech-line {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .about__links {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-4);
  }

  .about__links a {
    color: var(--color-accent);
  }
</style>
