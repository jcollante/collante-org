---
import { siteConfig } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide site-footer__inner">
    <div class="site-footer__identity">
      <a href="/" class="site-footer__brand">
        collante<span class="site-footer__brand-accent">.ai</span>
      </a>
      <p class="site-footer__name">{siteConfig.name}</p>
      <p class="site-footer__role">{siteConfig.role}</p>
    </div>

    <ul class="site-footer__links">
      <li><a href={siteConfig.linkedInUrl}>LinkedIn</a></li>
      <li><a href={`mailto:${siteConfig.email}`}>Email</a></li>
      {siteConfig.githubUrl && (
        <li class="site-footer__links-secondary"><a href={siteConfig.githubUrl}>GitHub</a></li>
      )}
    </ul>

    <p class="site-footer__copyright">© {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-line);
    margin-top: var(--space-9);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .site-footer__brand {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .site-footer__brand-accent {
    color: var(--color-accent);
  }

  .site-footer__name {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .site-footer__role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-footer__links a:hover {
    color: var(--color-text);
  }

  .site-footer__links-secondary a {
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  .site-footer__copyright {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }
</style>
